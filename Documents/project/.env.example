# Копирай този файл на .env и попълни истинските стойности локално.
# .env никога не се качва в git — истинските ключове живеят само тук и в Render.

ANTHROPIC_API_KEY=
JWT_SECRET=

# По подразбиране (без DATABASE_URL) се ползва локален climby.db (SQLite).
# На Render: слагаш адреса на PostgreSQL инстанцията тук.
DATABASE_URL=

# Resend — имейли за потвърждение и забравена парола (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Climby <onboarding@resend.dev>

# Twilio — SMS кодове за телефон и забравена парола (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
