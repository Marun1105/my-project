# Копирай този файл на .env и попълни истинските стойности локално.
# .env никога не се качва в git — истинските ключове живеят само тук и в Render.

ANTHROPIC_API_KEY=

# ЗАДЪЛЖИТЕЛНО на сървъра. Подписва сесиите (JWT). Ако липсва, приложението вдига
# случаен ключ при всяко стартиране — работи, но всички остават извън профила си
# при всеки рестарт. Генерирай дълга случайна стойност, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# По подразбиране (без DATABASE_URL) се ползва локален climby.db (SQLite).
# На Render: слагаш адреса на PostgreSQL инстанцията тук.
DATABASE_URL=

# Колко обратни проксита стоят пред приложението — определя откъде се чете
# истинският IP адрес за лимита на заявките. Render = 1 (по подразбиране).
# 0 = приложението се вижда директно, без прокси (локално).
TRUSTED_PROXY_HOPS=1

# Resend — имейли за потвърждение и забравена парола (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Climby <onboarding@resend.dev>

# Twilio — SMS кодове за телефон и забравена парола (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
