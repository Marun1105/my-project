{
  "name": "climby",
  "productName": "Climby",
  "version": "1.0.8",
  "description": "Climby — climb your way to success",
  "author": "Martin Hristov",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always",
    "dist:store": "electron-builder --win appx",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.martinhristov.climby",
    "productName": "Climby",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Marun1105",
        "repo": "my-project",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/.pytest_cache/**",
          "!**/__pycache__/**",
          "!**/.playwright-mcp/**"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Climby",
        "schemes": [
          "climby"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "${productName}-${version}-portable.${ext}",
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Climby"
    },
    "appx": {
      "identityName": "MartinHristov.Climby",
      "publisher": "CN=00000000-0000-0000-0000-000000000000",
      "publisherDisplayName": "Martin Hristov",
      "applicationId": "Climby",
      "displayName": "Climby",
      "backgroundColor": "#101010",
      "languages": [
        "en-US",
        "bg-BG"
      ],
      "artifactName": "${productName}-${version}-store.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "../frontend/icon-512.png",
      "category": "Education",
      "artifactName": "${productName}-${version}.${ext}",
      "synopsis": "Understand your homework, don't copy it",
      "description": "Photograph a problem from the textbook and ClimbAI works through it with you, step by step."
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
