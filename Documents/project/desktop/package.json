{
  "name": "climby",
  "productName": "Climby",
  "version": "1.0.4",
  "description": "Climby — изкачи се към успеха",
  "author": "Martin Hristov",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.martinhristov.climby",
    "productName": "Climby",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Marun1105",
        "repo": "my-project",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/.pytest_cache/**",
          "!**/__pycache__/**",
          "!**/.playwright-mcp/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../frontend/icon-512.png"
    },
    "artifactName": "${productName}-${version}-portable.${ext}",
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Climby"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
